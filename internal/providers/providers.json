{
  "cash_limit_usd": 30,
  "runner_free_minutes": 2000,
  "allowance_markers": [
    "allowance exhausted",
    "insufficient credit",
    "insufficient balance",
    "quota exceeded",
    "payment required"
  ],
  "availability_markers": [
    "model not found",
    "model not available",
    "model unavailable",
    "no endpoints found",
    "rate limited",
    "overloaded",
    "service unavailable",
    "bad gateway"
  ],
  "providers": {
    "command-code": {
      "base_url": "https://api.commandcode.ai/provider/v1",
      "key_secret": "COMMANDCODE_API_KEY",
      "windows": [
        {
          "name": "command-code-goat-5h",
          "hours": 5,
          "limit_usd": 14
        },
        {
          "name": "command-code-goat-week",
          "hours": 168,
          "limit_usd": 35
        },
        {
          "name": "command-code-goat-month",
          "hours": 720,
          "limit_usd": 70
        }
      ],
      "model_caps": {
        "command-code/deepseek/deepseek-v4.1-flash": 60
      },
      "harnesses": {
        "default": "omp",
        "fallbacks": ["command-code"]
      },
      "rates": {
        "command-code/deepseek/deepseek-v4.1-flash": {
          "input_usd_per_mtok": 0.15,
          "output_usd_per_mtok": 0.6,
          "cache_read_usd_per_mtok": 0.003,
          "cache_write_usd_per_mtok": 0,
          "peak": {
            "multiplier": 2,
            "weekday_utc_hours": [
              { "from": 1, "to": 4 },
              { "from": 6, "to": 10 }
            ]
          }
        }
      }
    }
  }
}
